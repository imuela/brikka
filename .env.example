# BRIKA — Sprint 0 environment variables (local development only)
# Copy to .env before running docker compose. Never commit the real .env file.

# --- PostgreSQL (container, empty — no schema in Sprint 0) ---
POSTGRES_DB=brika
POSTGRES_USER=brika
POSTGRES_PASSWORD=brika_dev_password
POSTGRES_PORT=15432

# --- RabbitMQ ---
RABBITMQ_USER=brika
RABBITMQ_PASSWORD=brika_dev_password
RABBITMQ_PORT=25672
RABBITMQ_MANAGEMENT_PORT=35672
RABBITMQ_ERLANG_COOKIE=brika_dev_cookie

# --- Object Storage (MinIO, S3-compatible local) ---
MINIO_ROOT_USER=brika
MINIO_ROOT_PASSWORD=brika_dev_password
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
MINIO_BUCKET=brika-documents

# --- OIDC / Identity local (Keycloak dev mode) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_password
KEYCLOAK_HTTP_PORT=18081
KEYCLOAK_HEALTH_PORT=19090

# Non-standard host ports are used above (15432, 25672, 35672, 19000, 19001,
# 18081, 19090) to avoid colliding with other local services. Adjust freely
# for your machine; only the container-internal ports are fixed.

# --- Backend OAuth2 Resource Server (Sprint 2, ADR-IDENTITY-001) ---
# Sprint 13 (ADR-FRONTEND-001, D2): the "brika" realm is now provisioned automatically
# by keycloak/brika-realm.json (imported via --import-realm in docker-compose.yml), with
# a public "brika-frontend" client (PKCE S256, Authorization Code, redirect to
# localhost:4200) and one seeded demo user. OIDC_EXPECTED_AUDIENCE stays empty: public/
# PKCE clients get no audience claim by default, so setting one here would reject every
# real token.
OIDC_ISSUER_URI=http://localhost:18081/realms/brika
OIDC_EXPECTED_AUDIENCE=

# --- Backend Portal Cliente OAuth2 Resource Server (Sprint 7, ADR-PORTAL-AUTH-001) ---
# Separate Keycloak realm from OIDC_ISSUER_URI above — same Keycloak instance,
# no new service. Not provisioned yet either; same lazy-decoder rationale.
OIDC_PORTAL_ISSUER_URI=http://localhost:18081/realms/brika-portal
OIDC_PORTAL_EXPECTED_AUDIENCE=

# --- Backend AI Gateway (Sprint 10, D10-4/D10-5) ---
# Local transport is the default: the Gateway resolves document extraction results
# in-process, honestly reporting "no provider" (D10-2), no network call, no Python
# process required. Set AI_WORKER_TRANSPORT=http only once ai-worker/ (a real, separate
# process — see ai-worker/main.py) is actually running and reachable at AI_WORKER_URL.
AI_WORKER_TRANSPORT=local
AI_WORKER_URL=http://localhost:8100
AI_CALLBACK_BASE_URL=http://localhost:8080
# Shared secret the Worker must send back on its callback (X-Ai-Worker-Secret header).
# Left empty by default, which makes the callback endpoint reject every request rather
# than accept one unauthenticated — set a real value before enabling AI_WORKER_TRANSPORT=http.
AI_WORKER_CALLBACK_SECRET=

# --- Backend Object Storage client (Sprint 4) ---
# Points at the same MinIO instance above; MINIO_ROOT_USER/PASSWORD/BUCKET are
# reused as the S3 access key/secret/bucket.
STORAGE_ENDPOINT=http://localhost:19000
STORAGE_REGION=us-east-1
STORAGE_PRESIGNED_TTL_SECONDS=300

# --- Backend (Spring Boot skeleton — no business logic in Sprint 0) ---
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=local

# --- Backend CORS (Sprint 13, ADR-FRONTEND-001, D1) ---
# Comma-separated list of browser origins the API accepts cross-origin requests from.
# Never a wildcard (06_SECURITY_SPECIFICATION.md §9, "CORS controlado").
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Frontend (Angular, Sprint 13) ---
FRONTEND_PORT=4200
# Must match keycloak/brika-realm.json's "brika-frontend" client and the backend's
# OIDC_ISSUER_URI above.
FRONTEND_OIDC_ISSUER=http://localhost:18081/realms/brika
FRONTEND_OIDC_CLIENT_ID=brika-frontend
FRONTEND_OIDC_REDIRECT_URI=http://localhost:4200/auth/callback
FRONTEND_API_BASE_URL=http://localhost:8080
