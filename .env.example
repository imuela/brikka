# BRIKA — Sprint 0 environment variables (local development only)
# Copy to .env before running docker compose. Never commit the real .env file.

# --- PostgreSQL (container, empty — no schema in Sprint 0) ---
POSTGRES_DB=brika
POSTGRES_USER=brika
POSTGRES_PASSWORD=brika_dev_password
POSTGRES_PORT=15432

# --- RabbitMQ ---
RABBITMQ_USER=brika
RABBITMQ_PASSWORD=brika_dev_password
RABBITMQ_PORT=25672
RABBITMQ_MANAGEMENT_PORT=35672
RABBITMQ_ERLANG_COOKIE=brika_dev_cookie

# --- Object Storage (MinIO, S3-compatible local) ---
MINIO_ROOT_USER=brika
MINIO_ROOT_PASSWORD=brika_dev_password
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
MINIO_BUCKET=brika-documents

# Non-standard host ports are used above (15432, 25672, 35672, 19000, 19001)
# to avoid colliding with other local services. Adjust freely for your
# machine; only the container-internal ports are fixed.

# --- Autenticación propia de Brika (Sprint 22 cierre, ADR-AUTH-001) ---
# Único emisor de identidad en todo entorno local — Keycloak ha sido retirado por completo
# (27_KEYCLOAK_REMOVAL_ANALYSIS.md, informe de cierre Sprint 22). *_SIGNING_KEY_PEM son claves
# privadas RSA (PKCS8, DER en base64) — dejarlas vacías en desarrollo local genera un par
# efímero por proceso (los tokens dejan de validar tras reiniciar el backend); en cualquier
# entorno no efímero deben fijarse como secretos reales, nunca en este fichero ni en el
# repositorio.
SELF_AUTH_INTERNAL_SIGNING_KEY_PEM=
SELF_AUTH_PORTAL_SIGNING_KEY_PEM=
SELF_AUTH_ACCESS_TOKEN_TTL_SECONDS=900
SELF_AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
SELF_AUTH_PASSWORD_RESET_TTL_SECONDS=3600
SELF_AUTH_LOGIN_ATTEMPT_WINDOW_SECONDS=900
SELF_AUTH_LOGIN_ATTEMPT_MAX_FAILURES=5
# Shared secret for /internal/auth/** (InternalCredentialBootstrapController) — same pattern as
# AI_WORKER_CALLBACK_SECRET below. Empty by default: the endpoint rejects everything until a real
# dev secret is set locally. Only used to bootstrap/migrate local credentials, never a product
# feature.
INTERNAL_AUTH_BOOTSTRAP_SECRET=

# --- Mailpit local SMTP catcher (Sprint 22 cierre, punto 5) ---
# NOT a production email provider — a local-only SMTP catcher with a web UI to open the emails
# password-reset actually sends during local testing. See docker-compose.yml "mailpit" service.
MAILPIT_SMTP_PORT=11025
MAILPIT_HTTP_PORT=18025
# Base URL the backend embeds in password-reset emails as the link back to the frontend.
FRONTEND_BASE_URL=http://localhost:4200
# Transporte de email por perfil (Sprint 24): "smtp" en LOCAL (Mailpit) y PROD, "test" en TEST,
# nunca "noop" fuera de local/test. LOCAL lo fuerza a "smtp" por defecto para recibir de verdad
# los correos en Mailpit.
EMAIL_TRANSPORT=smtp
EMAIL_FROM=no-reply@brika.local

# --- SMTP real de producción (Sprint 24, application-prod.yml) ---
# Solo relevantes con SPRING_PROFILES_ACTIVE=prod. ProdEnvironmentValidator aborta el arranque si
# SMTP_HOST falta o el transporte no es "smtp". Valores reales vienen del gestor de secretos del
# orquestador, nunca de este fichero.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@brika.com
# SMTP_FROM_NAME=Brika
# SMTP_TLS=true
# SMTP_AUTH=false

# --- Seed reproducible (Sprint 24) ---
# En LOCAL está habilitado por defecto; en TEST deshabilitado por defecto; en PROD terminantemente
# prohibido (validado fail-closed). Crea empresa demo, usuarios superadmin/manager/broker y bancos.
# SEED_ENABLED=true
# SEED_DEFAULT_PASSWORD=brika_dev_password

# --- Backend AI Gateway (Sprint 10, D10-4/D10-5) ---
# Local transport is the default: the Gateway resolves document extraction results
# in-process, honestly reporting "no provider" (D10-2), no network call, no Python
# process required. Set AI_WORKER_TRANSPORT=http only once ai-worker/ (a real, separate
# process — see ai-worker/main.py) is actually running and reachable at AI_WORKER_URL.
AI_WORKER_TRANSPORT=local
AI_WORKER_URL=http://localhost:8100
AI_CALLBACK_BASE_URL=http://localhost:8080
# Shared secret the Worker must send back on its callback (X-Ai-Worker-Secret header).
# Left empty by default, which makes the callback endpoint reject every request rather
# than accept one unauthenticated — set a real value before enabling AI_WORKER_TRANSPORT=http.
AI_WORKER_CALLBACK_SECRET=

# --- Backend Object Storage client (Sprint 4) ---
# Points at the same MinIO instance above; MINIO_ROOT_USER/PASSWORD/BUCKET are
# reused as the S3 access key/secret/bucket.
STORAGE_ENDPOINT=http://localhost:19000
STORAGE_REGION=us-east-1
STORAGE_PRESIGNED_TTL_SECONDS=300

# --- Backend (Spring Boot skeleton — no business logic in Sprint 0) ---
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=local

# --- Backend CORS (Sprint 13, ADR-FRONTEND-001, D1) ---
# Comma-separated list of browser origins the API accepts cross-origin requests from.
# Never a wildcard (06_SECURITY_SPECIFICATION.md §9, "CORS controlado").
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Frontend (Angular, Sprint 13) ---
FRONTEND_PORT=4200
FRONTEND_API_BASE_URL=http://localhost:8080
