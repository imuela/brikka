# BRIKA — Sprint 0 environment variables (local development only)
# Copy to .env before running docker compose. Never commit the real .env file.

# --- PostgreSQL (container, empty — no schema in Sprint 0) ---
POSTGRES_DB=brika
POSTGRES_USER=brika
POSTGRES_PASSWORD=brika_dev_password
POSTGRES_PORT=15432

# --- RabbitMQ ---
RABBITMQ_USER=brika
RABBITMQ_PASSWORD=brika_dev_password
RABBITMQ_PORT=25672
RABBITMQ_MANAGEMENT_PORT=35672
RABBITMQ_ERLANG_COOKIE=brika_dev_cookie

# --- Object Storage (MinIO, S3-compatible local) ---
MINIO_ROOT_USER=brika
MINIO_ROOT_PASSWORD=brika_dev_password
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
MINIO_BUCKET=brika-documents

# --- OIDC / Identity local (Keycloak dev mode) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_password
KEYCLOAK_HTTP_PORT=18081
KEYCLOAK_HEALTH_PORT=19090

# Non-standard host ports are used above (15432, 25672, 35672, 19000, 19001,
# 18081, 19090) to avoid colliding with other local services. Adjust freely
# for your machine; only the container-internal ports are fixed.

# --- Backend (Spring Boot skeleton — no business logic in Sprint 0) ---
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=local

# --- Frontend (Angular skeleton) ---
FRONTEND_PORT=4200
