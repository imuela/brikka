<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.brika</groupId>
    <artifactId>brika-backend</artifactId>
    <version>0.0.1-SPRINT1</version>
    <name>brika-backend</name>
    <description>Brika V1 backend — Sprint 1 foundation (Flyway/persistence config, no business logic)</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Sprint 2: OAuth2/OIDC resource server (19_IDENTITY_OAUTH_SPECIFICATION.md
             §1 "Spring Security validará tokens"). Backend validates bearer tokens against
             its own self-issued JWTs (Sprint 22, ADR-AUTH-001 — Keycloak retired) via the
             resource-server JwtDecoder infrastructure this starter provides. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- Sprint 22 (autenticación propia, autorización §2/§11): Argon2PasswordEncoder
             (spring-security-crypto) requires a BouncyCastle Argon2 implementation on the
             classpath — the JDK has none built in. This is the dependency Spring Security's
             own documentation names for Argon2id support, not an arbitrary addition.
             Post-Sprint 27 remediation Fase 3: bumped to 1.80.2 (from 1.78.1) to fix
             CVE-2025-14813 (GOST CTR mode) — the exact minimum version the advisory names as
             fixed, chosen deliberately over a newer one since bc-java's own release notes
             were not reachable to verify anything further introduces no regressions. -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.80.2</version>
        </dependency>

        <!-- Sprint 22 cierre, punto 5: EmailService abstraction backing password reset locally
             (Mailpit as SMTP catcher). The standard Spring starter for SMTP, not an arbitrary
             framework — swapping Mailpit for a real relay later is a config change, not a
             dependency change. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- Sprint 26: async notification events (20_RABBITMQ_SPECIFICATION.md). The standard
             Spring AMQP starter is the expected client for the RabbitMQ broker defined in
             docs/docker-compose.yml, not an arbitrary framework. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!-- Sprint 4: Object Storage (18_STORAGE_SPECIFICATION.md §2, "S3 API compatible").
             MinIO (Sprint 0 infra) speaks the S3 API, so the standard AWS S3 SDK is the
             expected client, not an arbitrary framework — url-connection-client is the
             lightweight sync HTTP implementation, avoiding pulling in Netty/Apache. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>url-connection-client</artifactId>
        </dependency>

        <!-- Sprint 1: persistence configuration and Flyway. No JPA entities
             yet — there is no business/domain code to map, so jdbc (not
             data-jpa) is the minimal dependency that gives us a DataSource,
             connection pooling, actuator DB health, and a target for Flyway. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>minio</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>rabbitmq</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>1.21.4</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>2.28.16</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Post-Sprint 27 remediation Fase 6: explicit overrides one patch ahead of the
                 Spring Boot 3.5.16 BOM, each investigated individually (compatibility, actual
                 code exposure) before applying — never bumped just because Trivy said so.

                 amqp-client 5.25.0 -> 5.33.1: fixes CVE-2026-63337/69219/69220. 5.33.0 itself
                 introduced deliberate breaking changes (TLS hostname verification on by default,
                 JSON-RPC allowlist) — verified irrelevant here: RabbitMqConfig only ever touches
                 Spring AMQP's own ConnectionFactory interface, never com.rabbitmq.client's, and
                 application.yml has no TLS config for RabbitMQ. -->
            <dependency>
                <groupId>com.rabbitmq</groupId>
                <artifactId>amqp-client</artifactId>
                <version>5.33.1</version>
            </dependency>

            <!-- Netty 4.1.135.Final -> 4.1.136.Final (all artifacts, kept aligned to avoid
                 version skew within the Netty family): fixes CVE-2026-59901/55831/55833/56745/
                 56819. Netty only enters via awssdk netty-nio-client, an async HTTP client that
                 is never instantiated — StorageConfig builds a sync S3Client with no explicit
                 httpClient, so it resolves url-connection-client via SPI; no Netty channel is
                 ever created. A same-minor-line patch bump on a dormant dependency. -->
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-bom</artifactId>
                <version>4.1.136.Final</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- PostgreSQL driver 42.7.11 -> 42.7.12: fixes CVE-2026-54291 (SCRAM-SHA-256-PLUS
                 channel-binding downgrade). Single patch, same pattern already validated in
                 Fase 5 (42.7.7 -> 42.7.11 across all 432 tests, including every Testcontainers
                 Postgres IT, with zero issues). -->
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>42.7.12</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- *IT classes (Testcontainers-backed) run here, bound to verify,
                 not under plain unit-test `surefire:test`, since they need Docker
                 and are slower. CI must run `mvn verify`, not just `mvn test`. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>2.43.0</version>
                <configuration>
                    <java>
                        <googleJavaFormat/>
                        <removeUnusedImports/>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <id>spotless-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
